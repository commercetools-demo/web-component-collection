    },
    "./split-shipping": {
      "types": "./public/types/split-shipping.d.ts",
      "import": "./public/split-shipping.js"
    },
    "./split-shipping-checkout": {
      "types": "./public/types/split-shipping-checkout.d.ts",
      "import": "./public/split-shipping-checkout.js"
    },
    "./address-form": {
      "types": "./public/types/address-form.d.ts",
