    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.2.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^4.0.0",
